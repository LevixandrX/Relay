{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@relay-messages/*": ["../messages/*"],
      "@relay-i18n/*": ["../src/i18n/*"],
      "@relay-board/*": ["../src/lib/board/*"],
      "@relay-board-chrome": ["../src/components/BoardChrome.tsx"],
      "@relay-help": ["../src/components/BoardHelp.tsx"],
      "@relay-activity": ["../src/components/ActivityDisclosure.tsx"],
      "@relay-search": ["../src/components/SearchPalette.tsx"],
      "@relay-history": ["../src/components/VersionHistory.tsx"],
      "@relay-mode-switch": ["../src/components/ContentModeSwitch.tsx"],
      "@relay-activity-refresh": ["../src/lib/activity-refresh.ts"],
      "@relay-account": ["../src/components/AccountSettings.tsx"],
      "@relay-avatar": ["../src/components/UserAvatar.tsx"]
    }
  },
  "include": ["src"]
}
