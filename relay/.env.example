# Скопируй в relay/.env.local — приложение читает переменные только оттуда.
#
# Auth / crypto
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# LibSQL file database (created automatically)
DATABASE_URL=file:./data/relay.db

# Optional — enables LLM-backed Live Prompt (otherwise local heuristics)
# OPENAI_API_KEY=

# App URL (for share links + OAuth redirect base)
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# OAuth. Callbacks (local):
#   {AUTH_URL}/api/v1/auth/oauth/google/callback
#   {AUTH_URL}/api/v1/auth/oauth/github/callback
#   {AUTH_URL}/api/v1/auth/oauth/yandex/callback
#   {AUTH_URL}/api/v1/auth/oauth/vk/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# VK отложен: VK ID требует подтверждение бизнеса (ИНН). Роуты оставлены, кнопок в UI нет.
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=

# CORS for desktop Vite / Tauri (comma-separated)
CORS_ORIGINS=http://127.0.0.1:1420,http://localhost:1420,tauri://localhost,https://tauri.localhost

# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-For
# TRUST_PROXY=0

# Live board sync (Quickdraw multiplayer relay, started with npm run dev)
NEXT_PUBLIC_BOARD_SYNC_URL=ws://127.0.0.1:3001
