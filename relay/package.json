{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:clean": "node scripts/dev.mjs --clean",
    "board:sync": "node scripts/board-sync.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "db:migrate": "tsx --env-file=.env.local src/db/migrate.ts",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:tauri": "npm --prefix desktop run tauri:dev",
    "desktop:build": "npm --prefix desktop run tauri:build",
    "desktop:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-desktop.ps1",
    "relay:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-relay.ps1",
    "relay:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-desktop-shortcut.ps1",
    "desktop:dev-ui": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-desktop.ps1 -Dev",
    "desktop:rebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-desktop.ps1 -Rebuild",
    "postinstall": "node scripts/patch-quickdraw.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@libsql/client": "^0.17.4",
    "@quickdrawjs/react": "^0.2.0",
    "@tiptap/extension-code-block-lowlight": "^3.29.0",
    "@tiptap/extension-link": "^3.29.0",
    "@tiptap/extension-placeholder": "^3.29.0",
    "@tiptap/extension-task-item": "^3.29.0",
    "@tiptap/extension-task-list": "^3.29.0",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.4",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.26.0",
    "nanoid": "^6.0.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rope-sequence": "^1.3.4",
    "use-sync-external-store": "^1.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "ws": "^8.21.3"
  }
}
